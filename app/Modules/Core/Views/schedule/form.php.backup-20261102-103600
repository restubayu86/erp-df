<script src="<?= base_url('assets/vendors/select2/select2.full.min.js') ?>"></script>
<script>
(function () {
  const jq = window.jQuery || window.$;
  if (jq) {
    jq(function() {
      jq('select.form-select').select2({
        theme: 'bootstrap-5',
        width: '100%'
      });
    });
  }
  const DEFS = <?= json_encode(array_map(static fn ($d) => ['code' => $d['code'], 'type' => $d['data_type'], 'req' => (int) $d['is_required']], $defs)) ?>;
  const ITEMS = <?= json_encode($items) ?>;
  const APPROVED = <?= json_encode((bool) $approved) ?>;
  const API = <?= json_encode(site_url('api/shift/effective')) ?>;
  const API_IFS = <?= json_encode(site_url('api/ifs')) ?>;
  const qs = (s) => document.querySelector(s);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const debounce = (fn, ms = 300) => { let tid; return (...args) => { clearTimeout(tid); tid = setTimeout(() => fn(...args), ms); }; };
  const tbody = qs('#itemsTable tbody');
  let n = 0;
  
  // Helper to safely reinitialize Select2
  const initSelect2 = (selector) => {
    const jq = window.jQuery || window.$;
    if (!jq) return;
    const elem = typeof selector === 'string' ? qs(selector) : selector;
    if (!elem) return;
    if (jq(elem).hasClass('select2-hidden-accessible')) {
      jq(elem).select2('destroy');
    }
    jq(elem).select2({ theme: 'bootstrap-5', width: '100%' });
  };

  // Helper functions for priority visual
  function updatePriorityPreview() {
    const priority = qs('#priority').value || 'normal';
    const prioData = {
      'urgent': { color: '#e63757', name: 'Urgent', bgClass: 'badge-subtle-danger' },
      'high': { color: '#f6ad55', name: 'High', bgClass: 'badge-subtle-warning' },
      'normal': { color: '#2563eb', name: 'Medium', bgClass: 'badge-subtle-primary' }
    };
    const data = prioData[priority] || prioData['normal'];
    
    const preview = qs('#priorityPreview');
    preview.innerHTML = `<div class="priority-badge">
      <div class="priority-gauge" style="--falcon-circle-progress-bar:0">
        <svg viewBox="0 0 120 120">
          <circle class="gauge-rail" cx="60" cy="60" r="54" fill="none" stroke-linecap="round" stroke-width="12"></circle>
          <circle class="gauge-fill" cx="60" cy="60" r="54" fill="none" stroke-linecap="round" stroke="${data.color}" stroke-width="12" stroke-dasharray="339.29" stroke-dashoffset="339.29" style="transform: rotate(-90deg); transform-origin: 50% 50%;"></circle>
        </svg>
      </div>
      <span class="badge ${data.bgClass}">${data.name}</span>
    </div>`;
  }

  // Helper function for shift badge
  function updateShiftBadge() {
    const shiftSel = qs('#shift_id');
    const selected = shiftSel.options[shiftSel.selectedIndex];
    if (!selected || !selected.value) {
      qs('#shiftBadge').innerHTML = '';
      return;
    }
    
    const shiftName = selected.dataset.name || selected.text.split('(')[0].trim();
    const shiftColors = {
      'Pagi': 'primary',
      'Siang': 'warning',
      'Malam': 'dark'
    };
    const color = shiftColors[shiftName] || 'success';
    
    qs('#shiftBadge').innerHTML = `<span class="badge badge-subtle-${color} shift-badge"><span class="fas fa-business-time me-1"></span>${esc(shiftName)}</span>`;
  }

  function addRow(it = {}) {
    const i = n++;
    const tr = document.createElement('tr');
    tr.className = 'item-main-row';
    tr.dataset.itemIndex = i;

    // Main row cells
    const orderInput = `<input class="form-control form-control-sm" name="items[${i}][order_no]" value="${esc(it.order_no)}" maxlength="50" required placeholder="No. Order">`;
    const customerInput = `<input class="form-control form-control-sm" name="items[${i}][customer_name]" value="${esc(it.customer_name)}" maxlength="100" placeholder="Customer">`;
    const designInput = `<input class="form-control form-control-sm" name="items[${i}][design_name]" value="${esc(it.design_name || it.article)}" maxlength="100" placeholder="Desain">`;
    const colorInput = `<input class="form-control form-control-sm" name="items[${i}][color_name]" value="${esc(it.color_name)}" maxlength="50" placeholder="Warna">`;
    const mpInput = `<input class="form-control form-control-sm" name="items[${i}][mp_no]" value="${esc(it.mp_no)}" maxlength="50" placeholder="MP">`;
    const lotInput = `<input class="form-control form-control-sm" name="items[${i}][lot_no]" value="${esc(it.lot_no)}" maxlength="50" placeholder="Lot">`;

    tr.innerHTML = `
      <td class="text-600 align-middle">${tbody.children.length + 1}
        <input type="hidden" name="items[${i}][id]" value="${it.id || 0}">
        <input type="hidden" name="items[${i}][source_type]" value="${esc(it.source_type || 'manual')}">
        <input type="hidden" name="items[${i}][source_item_id]" value="${esc(it.source_item_id || '')}">
      </td>
      <td>${orderInput}</td>
      <td>${customerInput}</td>
      <td>${designInput}</td>
      <td>${colorInput}</td>
      <td>${mpInput}</td>
      <td>${lotInput}</td>
      <td class="align-middle">
        <button type="button" class="btn btn-falcon-default btn-sm px-2 py-1 btn-toggle-params" data-item-index="${i}">
          <span class="fas fa-sliders-h text-primary me-1"></span>
          <span class="param-count badge badge-subtle-info">${DEFS.length}</span>
        </button>
      </td>
      <td class="align-middle text-center">
        <button type="button" class="btn btn-link text-danger p-0 btn-del" title="Hapus item">
          <span class="fas fa-times"></span>
        </button>
      </td>
    `;
    
    tbody.appendChild(tr);

    // Parameter row (collapsed by default)
    const paramTr = document.createElement('tr');
    paramTr.className = 'item-params-row';
    paramTr.dataset.itemIndex = i;
    paramTr.style.display = 'none';
    
    let paramsHtml = '<div class="p-3 bg-light"><div class="row g-2">';
    DEFS.forEach((d) => {
      const val = (it.params || {})[d.code];
      const label = d.code === 'CUCI_MESIN' ? 'Cuci Mesin' : d.name;
      
      if (d.code === 'CUCI_MESIN' || d.type === 'boolean') {
        const falseValues = [null, undefined, '', 0, '0', 'tidak', 'no', false];
        const isChecked = !falseValues.includes(val);
        paramsHtml += `
          <div class="col-md-6">
            <label class="form-label fs-10">${esc(label)}${d.req ? ' *' : ''}</label>
            <div class="form-check form-switch">
              <input type="hidden" name="items[${i}][params][${d.code}]" value="0">
              <input class="form-check-input" type="checkbox" name="items[${i}][params][${d.code}]" value="1" ${isChecked ? 'checked' : ''}>
              <label class="form-check-label fs-10">${isChecked ? 'Ya' : 'Tidak'}</label>
            </div>
          </div>`;
      } else {
        const uom = d.uom ? ` (${d.uom})` : '';
        paramsHtml += `
          <div class="col-md-6">
            <label class="form-label fs-10">${esc(label)}${uom}${d.req ? ' *' : ''}</label>
            <input class="form-control form-control-sm" name="items[${i}][params][${d.code}]" value="${esc(val)}" ${d.type === 'number' ? 'inputmode="decimal"' : ''} ${d.req ? 'required' : ''} placeholder="${esc(label)}">
          </div>`;
      }
    });
    paramsHtml += '</div></div>';
    
    paramTr.innerHTML = `<td colspan="9">${paramsHtml}</td>`;
    tbody.appendChild(paramTr);
  }
  
  function renumber() { 
    [...tbody.querySelectorAll('.item-main-row')].forEach((tr, k) => { 
      const firstCell = tr.querySelector('td:first-child');
      if (firstCell) {
        const textNode = firstCell.firstChild;
        if (textNode && textNode.nodeType === Node.TEXT_NODE) {
          textNode.nodeValue = k + 1;
        }
      }
    }); 
  }
  
  ITEMS.forEach(addRow);
  
  qs('#btnAddItem').addEventListener('click', () => addRow());
  
  tbody.addEventListener('click', (e) => {
    const delBtn = e.target.closest('.btn-del');
    if (delBtn) {
      const tr = delBtn.closest('tr');
      if (!tr || !tr.parentElement) return;
      
      const itemIndex = tr.dataset.itemIndex;
      const paramRow = tbody.querySelector(`.item-params-row[data-item-index="${itemIndex}"]`);
      
      if (tbody.querySelectorAll('.item-main-row').length > 1) { 
        tr.remove();
        if (paramRow) paramRow.remove();
        renumber(); 
      } else {
        alert('Minimal 1 item harus tetap ada. Silakan tambah item lain sebelum menghapus item terakhir.');
      }
      return;
    }
    
    const toggleBtn = e.target.closest('.btn-toggle-params');
    if (toggleBtn) {
      const itemIndex = toggleBtn.dataset.itemIndex;
      const paramRow = tbody.querySelector(`.item-params-row[data-item-index="${itemIndex}"]`);
      if (paramRow) {
        const isVisible = paramRow.style.display !== 'none';
        paramRow.style.display = isVisible ? 'none' : '';
        const icon = toggleBtn.querySelector('.fas');
        if (icon) {
          icon.className = isVisible ? 'fas fa-sliders-h text-primary me-1' : 'fas fa-sliders-h text-success me-1';
        }
      }
    }
  });

  // ---- IFS
  let ifsTable = null;
  const ifsModal = new bootstrap.Modal(qs('#ifsModal'));
  qs('#btnIfs').addEventListener('click', () => {
    ifsModal.show();
    if (!ifsTable) {
      ifsTable = qs('#ifsTable');
      const jq = window.jQuery || window.$;
      if (jq) {
        jq(ifsTable).DataTable({
          processing: true, serverSide: true, ajax: API_IFS + '/datatable',
          columns: [
            { data: 'dop_no' }, { data: 'order_no' }, { data: 'customer_name' },
            { data: 'article' }, { data: 'qty', render: (v, t, r) => v + ' ' + r.uom },
            { data: 'action', orderable: false, searchable: false, className: 'text-end' }
          ],
          language: { search: '', searchPlaceholder: 'Cari DOP/Order/Customer...' }
        });

        jq(ifsTable).on('click', '.btn-select-ifs', async function() {
          const dop = this.dataset.dop;
          const btn = this;
          const originalHtml = btn.innerHTML;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
          btn.disabled = true;
          
          try {
            const response = await fetch(API_IFS + '/detail/' + dop, { credentials: 'same-origin' });
            
            if (!response.ok) {
              const errorMsg = response.status === 404 ? 'Data tidak ditemukan' 
                             : response.status === 500 ? 'Server error' 
                             : `HTTP error: ${response.status}`;
              throw new Error(errorMsg);
            }
            
            const d = await response.json();
            
            // Find primary parameter to autofill
            const primaryParam = DEFS.find(def => def.req) || DEFS[0];
            const params = primaryParam ? { [primaryParam.code]: d.qty } : {};
            
            addRow({
              order_no: d.order_no, 
              customer_name: d.customer_name, 
              article: d.article,
              color_name: d.color_name, 
              source_type: 'ifs', 
              source_item_id: d.dop_no,
              params: params
            });
            
            ifsModal.hide();
          } catch (e) {
            console.error('IFS detail fetch error:', e);
            const errorMsg = e.message || 'Gagal mengambil detail IFS';
            if (window.bootstrap && window.bootstrap.Toast) {
              // Use Bootstrap toast if available
              const toastEl = document.createElement('div');
              toastEl.className = 'toast align-items-center text-bg-danger border-0 position-fixed bottom-0 end-0 m-3';
              toastEl.setAttribute('role', 'alert');
              toastEl.innerHTML = `<div class="d-flex"><div class="toast-body">${esc(errorMsg)}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
              document.body.appendChild(toastEl);
              const toast = new bootstrap.Toast(toastEl);
              toast.show();
              setTimeout(() => toastEl.remove(), 5000);
            } else {
              alert(errorMsg);
            }
          } finally {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
          }
        });
      }
    } else {
      const jq = window.jQuery || window.$;
      if (jq) jq(ifsTable).DataTable().ajax.reload();
    }
  });

  // ---- shift efektif sesuai tanggal (kalender shift)
  const shiftSel = qs('#shift_id');
  async function loadShifts(keepSelected) {
    const date = qs('#work_date').value;
    if (!date) return;
    const keep = keepSelected ? (shiftSel.dataset.selected || shiftSel.value) : '';
    try {
      const d = await (await fetch(API + '?date=' + date, { credentials: 'same-origin' })).json();
      shiftSel.innerHTML = d.shifts.length
        ? '<option value="">Pilih shift</option>' + d.shifts.map((s) => `<option value="${s.shift_id}" data-start="${esc(s.start_at)}" data-end="${esc(s.end_at)}" data-name="${esc(s.name)}">${esc(s.name)} (${esc(s.start)}–${esc(s.end)})</option>`).join('')
        : '<option value="">Tidak ada shift aktif pada tanggal ini</option>';
      if (keep) shiftSel.value = keep;
      initSelect2(shiftSel);
      const jq = window.jQuery || window.$;
      if (jq) jq(shiftSel).trigger('change');
      qs('#patternInfo').textContent = d.pattern ? 'Pola: ' + d.pattern.name + (d.pattern.reason ? ' – ' + d.pattern.reason : '') : '';
      updateShiftBadge();
    } catch (e) { 
      console.error('Load shifts error:', e);
    }
  }
  const toLocal = (s) => String(s).replace(' ', 'T').slice(0, 16);
  qs('#work_date').addEventListener('change', debounce(() => { shiftSel.dataset.selected = ''; loadShifts(false); }, 300));
  shiftSel.addEventListener('change', () => {
    updateShiftBadge();
    const o = shiftSel.selectedOptions[0];
    if (o && o.dataset.start && !qs('#start_at').value) qs('#start_at').value = toLocal(o.dataset.start);
    hint();
  });

  // ---- estimasi selesai dari durasi standar proses (bila belum diisi) + peringatan overshift
  function addMin(v, m) { const d = new Date(v); d.setMinutes(d.getMinutes() + m); return new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16); }
  function hint() {
    const o = shiftSel.selectedOptions[0], end = qs('#end_at').value;
    qs('#endInfo').textContent = (o && o.dataset.end && end && end > toLocal(o.dataset.end)) ? 'Melewati akhir shift – akan overshift.' : '';
  }
  function suggestEnd() {
    const std = parseInt(qs('#process_id').selectedOptions[0]?.dataset.std || '0', 10), st = qs('#start_at').value;
    if (std > 0 && st && !qs('#end_at').value) { qs('#end_at').value = addMin(st, std); hint(); }
  }
  qs('#process_id').addEventListener('change', suggestEnd); qs('#start_at').addEventListener('change', suggestEnd); qs('#end_at').addEventListener('change', hint);

  // Priority preview update
  qs('#priority').addEventListener('change', updatePriorityPreview);
  
  // Initial UI updates
  updatePriorityPreview();
  if (shiftSel.value) updateShiftBadge();

  if (shiftSel.options.length <= 1 && qs('#work_date').value) loadShifts(true);
  hint();

  // ---- Form validation before submit
  qs('#schForm').addEventListener('submit', (e) => {
    const errors = [];
    
    // Validate minimum 1 item
    if (tbody.children.length === 0) {
      errors.push('Minimal 1 item harus ditambahkan ke jadwal');
    }
    
    // Validate time range
    const startAt = qs('#start_at').value;
    const endAt = qs('#end_at').value;
    if (startAt && endAt && endAt <= startAt) {
      errors.push('Waktu selesai harus setelah waktu mulai');
    }
    
    // Validate shift boundary
    const shiftOpt = shiftSel.selectedOptions[0];
    if (shiftOpt && shiftOpt.dataset.end && endAt && endAt > toLocal(shiftOpt.dataset.end)) {
      const confirmOvershift = confirm('Jadwal melewati akhir shift. Apakah Anda yakin?');
      if (!confirmOvershift) {
        e.preventDefault();
        return;
      }
    }
    
    // Show errors if any
    if (errors.length > 0) {
      e.preventDefault();
      alert('Belum bisa disimpan:\n\n' + errors.map((err, idx) => `${idx + 1}. ${err}`).join('\n'));
      return;
    }
    
    // Confirm if schedule already approved
    if (APPROVED && !confirm('Jadwal sudah disetujui. Jika ada perubahan data penting, jadwal diajukan ulang ke Kepala Bagian dan sementara tidak tampil di tablet/TV. Lanjutkan?')) {
      e.preventDefault();
    }
  });
})();
</script>
<?= $this->endSection() ?>
